# Copy to `.env` and fill in real values. `.env` is gitignored.

# Any OpenAI-compatible chat-completions endpoint. The app appends /v1 itself,
# so give the server root (e.g. https://host:port), a /v1 suffix, or a full
# /v1/chat/completions URL — all three are accepted.
OPENAI_BASE_URL=http://127.0.0.1:11434
OPENAI_MODEL=gpt-oss:20b
OPENAI_API_KEY=

# These three are the single source of truth. The browser never sends an
# endpoint, model, or key — it reads them back from /api/ai/config for display
# only — so there is no client-side equivalent to set.

# Optional: embedding model on the same endpoint.
OPENAI_EMBEDDING_MODEL=

# --- End-to-end tests -------------------------------------------------------
# `npm run test:e2e` hits a real model. Without E2E_API_KEY (or E2E_BASE_URL
# pointing at a keyless endpoint) the suite skips instead of failing.
E2E_BASE_URL=
E2E_MODEL=
E2E_API_KEY=
E2E_TIMEOUT_MS=180000
